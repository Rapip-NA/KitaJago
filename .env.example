APP_NAME=JagoKita
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# Default database path: database/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# International digits only, without + or spaces. No fallback number.
ADMIN_WHATSAPP=
# Enable only after configuring a working SMTP transport.
PORTAL_SMTP_READY=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

OTP_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Send requests per hour; verify requests per five minutes.
OTP_SEND_EMAIL_LIMIT=5
OTP_SEND_IP_LIMIT=20
OTP_VERIFY_EMAIL_LIMIT=30
OTP_VERIFY_IP_LIMIT=30
